{
    "name": "centarro/cybersource-rest-client-php",
    "version": "0.0.44",
    "description": "CyberSource PHP REST API client with dependency updates for Drupal compatibility (until fixed upstream).",
    "homepage": "https://github.com/CyberSource/cybersource-rest-client-php",
    "require": {
        "php": ">=8.0.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "firebase/php-jwt": "^6.0.0",
	"monolog/monolog": ">=1.25.0",
        "web-token/jwt-framework": "^3.2.8"
    },
    "require-dev": {
        "phpunit/phpunit": "~4.8"
    },
    "autoload": {
        "psr-4": { "CyberSource\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "CyberSource\\" : "test/" }
    }
}
